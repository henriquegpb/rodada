# URL pública do site, usada no texto de compartilhar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo que embaralha a ordem dos desafios. Sem ele, a sequência é a de desenvolvimento.
# Enquanto não há backend ele é público (vai no bundle); quando a validação for para o
# servidor, passa a ser DAILY_SEED, só do servidor.
NEXT_PUBLIC_DAILY_SEED=troque-por-um-valor-aleatorio
