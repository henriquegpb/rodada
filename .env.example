# URL pública do site, usada no texto de compartilhar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo que embaralha a ordem dos desafios. Sem ele, a sequência é a de desenvolvimento.
# Enquanto não há backend ele é público (vai no bundle); quando a validação for para o
# servidor, passa a ser DAILY_SEED, só do servidor.
NEXT_PUBLIC_DAILY_SEED=troque-por-um-valor-aleatorio

# --- Backend (Contas, Grupos, Rankings). Veja a seção Backend do README. ---

# Postgres (Neon). Na Vercel, a integração do Neon preenche sozinha.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Login (Better Auth). O segredo assina as sessões: gere com `openssl rand -base64 32`.
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio
# URL pública do site (a mesma do NEXT_PUBLIC_SITE_URL).
BETTER_AUTH_URL=http://localhost:3000

# Login com Google (opcional em desenvolvimento). Console do Google Cloud > Credenciais > OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio do link mágico pelo Resend. Sem a chave, o link aparece no terminal (bom para desenvolver).
RESEND_API_KEY=
EMAIL_FROM=Rodada <login@rodada.io>

# Fotos de perfil (Vercel Blob). Na Vercel, criar o Blob Store preenche sozinha.
BLOB_READ_WRITE_TOKEN=
